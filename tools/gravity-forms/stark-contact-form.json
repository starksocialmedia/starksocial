   },
   "stark-confirmation": {
    "id": "stark-confirmation",
    "name": "Thank You Confirmation",
    "event": "form_submission",
    "isActive": true,
    "toType": "field",
    "toField": "3",
    "to": "3",
    "from": "postmaster@mg.starksocial.com",
    "fromName": "Stark Social Media Agency",
    "replyTo": "hello@starksocial.com",
    "subject": "Thanks for getting in touch",
    "message": "<div style=\"margin:0 0 14px;\">Hi {Name:1},</div><div style=\"margin:0 0 14px;\">Thanks for reaching out to Stark Social. We read every message ourselves and we’ll get back to you within one business day.</div><div style=\"margin:0 0 14px;\">Here’s a copy of what you sent:</div>{stark_fields}<div>— Nathan and Deanna</div>"
   }
  }
 },
