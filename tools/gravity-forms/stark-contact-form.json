      "isSelected": false
     },
     {
      "text": "Content",
      "value": "content-creation",
      "isSelected": false
     },
     {
      "text": "Brand Strategy",
      "value": "brand-strategy-identity",
      "isSelected": false
     },
     {
      "text": "Audit",
      "value": "audit-consulting",
      "isSelected": false
     },
     {
      "text": "Not sure yet",
      "value": "not-sure",
      "isSelected": false
